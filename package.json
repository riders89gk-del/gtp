{
  "name": "promo-core-windows",
  "version": "1.0.3",
  "description": "PROMO CORE 배민 자동수집",
  "main": "main.js",
  "scripts": {
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "kr.co.riderpayments.promocore",
    "productName": "PROMO CORE",
    "files": [
      "main.js",
      "preload.js"
    ],
    "win": {
      "target": "portable",
      "artifactName": "PROMO_CORE_Windows.exe"
    }
  }
}
